{
  "name": "@tbela99/rust-css-parser-napi",
  "version": "2.3.2",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist",
    "!dist/css_parser.node",
    "rust",
    "!rust/target",
    "install.js",
    "README.md",
    "LICENSE.md"
  ],
  "description": "CSS parser, validator and minifier for node: the rust port of @tbela99/css-parser as a native N-API addon",
  "main": "./dist/node.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/node.js"
    },
    "./node": {
      "types": "./dist/index.d.ts",
      "default": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "install": "node install.js",
    "build": "sh ../../build-bindings.sh napi",
    "test": "cd ../.. && npm run test:napi",
    "prepublishOnly": "cd ../.. && npm run build:napi && npm run test:napi",
    "prepare": "node ../../scripts/prepare-extension.js napi"
  },
  "author": "Thierry Bela",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tbela99/rust-css-parser.git"
  },
  "keywords": [
    "parser",
    "css",
    "modules",
    "css-modules",
    "css-parser",
    "node",
    "ast",
    "nesting",
    "nested",
    "compiler",
    "browser",
    "css-nesting",
    "css-compiler",
    "nested-css",
    "walker",
    "stream",
    "streaming",
    "streaming-parser",
    "minifier",
    "validator",
    "rust",
    "napi",
    "native"
  ],
  "publishConfig": {
    "access": "public"
  },
  "os": [
    "darwin",
    "linux"
  ]
}

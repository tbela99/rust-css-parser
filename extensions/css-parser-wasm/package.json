{
  "name": "@tbela99/rust-css-parser-wasm",
  "version": "2.3.2",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "description": "CSS parser, validator and minifier for node and the browsers: the rust port of @tbela99/css-parser as a WebAssembly module",
  "main": "./dist/node.js",
  "types": "./dist/index.d.ts",
  "browser": "./dist/web.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/node.js",
      "default": "./dist/web.js"
    },
    "./node": {
      "types": "./dist/index.d.ts",
      "default": "./dist/node.js"
    },
    "./web": {
      "types": "./dist/index.d.ts",
      "default": "./dist/web.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "sh ../../build-bindings.sh wasm",
    "test": "cd ../.. && npm run test:wasm && npm run test:web",
    "prepublishOnly": "cd ../.. && npm run build:wasm && npm run test:wasm",
    "prepare": "node ../../scripts/prepare-extension.js wasm"
  },
  "author": "Thierry Bela",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tbela99/rust-css-parser.git"
  },
  "keywords": [
    "parser",
    "css",
    "modules",
    "css-modules",
    "css-parser",
    "node",
    "ast",
    "nesting",
    "nested",
    "compiler",
    "browser",
    "css-nesting",
    "css-compiler",
    "nested-css",
    "walker",
    "stream",
    "streaming",
    "streaming-parser",
    "minifier",
    "validator",
    "rust",
    "wasm",
    "napi",
    "webassembly",
    "browser"
  ],
  "publishConfig": {
    "access": "public"
  }
}
